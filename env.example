# Local development: run npm run chain and npm run deploy:local first.
APP_NETWORK=local
APP_ORIGIN=http://127.0.0.1:5000
RPC_URL=http://127.0.0.1:8545
# For Sepolia change APP_NETWORK=sepolia and RPC_URL to your HTTPS Sepolia RPC.
# Deploy at /deploy with MetaMask, then copy these two displayed values here.
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=
# Optional: default SQLite database is instance/savings.sqlite3.
# DATABASE_PATH=
